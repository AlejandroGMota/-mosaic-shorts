   "i": 7,
   "start": 10.08,
   "end": 11.5,
   "text": "plástico muy delgada.",
   "first": 31,
   "last": 33
  },
  {
   "i": 8,
   "start": 11.5,
   "end": 13.61,
   "text": "Los píxeles OLED se fabrican encima",
   "first": 34,
   "last": 39
  },
  {
   "i": 9,
   "start": 13.61,
   "end": 15.0,
   "text": "de esa capa flexible.",
   "first": 40,
   "last": 43
  },
  {
   "i": 10,
   "start": 15.0,
   "end": 17.3,
   "text": "Segundo, la física de un doblez.",
   "first": 44,
   "last": 49
  },
  {
   "i": 11,
   "start": 17.3,
   "end": 18.5,
   "text": "Cuando doblas algo,",
   "first": 50,
   "last": 52
  },
  {
   "i": 12,
   "start": 18.5,
   "end": 20.2,
   "text": "la cara de afuera se estira",
   "first": 53,
   "last": 58
  },
  {
   "i": 13,
   "start": 20.2,
   "end": 21.7,
   "text": "y la adentro se comprime.",
   "first": 59,
   "last": 63
  },
  {
   "i": 14,
   "start": 21.7,
   "end": 23.31,
   "text": "Pero en medio hay una línea que",
   "first": 64,
   "last": 70
  },
  {
   "i": 15,
   "start": 23.31,
   "end": 24.91,
   "text": "ni se estira ni se comprime,",
   "first": 71,
   "last": 76
  },
  {
   "i": 16,
   "start": 24.91,
   "end": 26.0,
   "text": "el plano neutro.",
   "first": 77,
   "last": 79
  },
  {
   "i": 17,
   "start": 26.14,
   "end": 28.11,
   "text": "Los ingenieros acomodan las capas",
   "first": 80,
   "last": 84
  },
  {
   "i": 18,
   "start": 28.11,
   "end": 29.21,
   "text": "para que lo más frágil,",
   "first": 85,
   "last": 89
  },
  {
   "i": 19,
   "start": 29.21,
   "end": 31.0,
   "text": "los circuitos y los píxeles,",
   "first": 90,
   "last": 94
  },
  {
   "i": 20,
   "start": 31.0,
   "end": 32.7,
   "text": "queden justo en esa parte plana.",
   "first": 95,
   "last": 100
  },
  {
   "i": 21,
   "start": 32.7,
   "end": 34.38,
   "text": "Así la pantalla se dobla miles",
